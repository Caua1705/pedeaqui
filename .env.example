# Vite environment — copy to `.env` (gitignored) and fill in real values.
# Only variables prefixed with VITE_ are exposed to the client bundle.

# Backend API base URL (no trailing slash).
VITE_API_BASE_URL=https://api.pederapidex.com

# Domínios-raiz onde <slug>.<dominio> identifica um restaurante (separados por vírgula).
# Hosts fora desta lista (preview do Vercel, localhost) resolvem o tenant só por path/query.
VITE_TENANT_ROOT_DOMAINS=rapidex.com,pederapidex.com

# Google Maps JavaScript + Places key.
# MUST be restricted in Google Cloud Console (HTTP referrers + Maps JS/Places).
# The key previously committed to git history is COMPROMISED — rotate it.
VITE_MAPS_KEY=
