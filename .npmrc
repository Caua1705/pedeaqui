# Faz o npm RECUSAR rodar quando a versao nao bate com "engines" do package.json,
# em vez de so avisar. O pin de npm ali e EXATO de proposito: a forma do lockfile
# muda entre MINORS do npm (11.3 e 11.6.2 discordam sobre gravar peerDependencies
# opcionais como entradas top-level), entao uma faixa como ">=11" nao garante que
# dois npms diferentes gerem o mesmo lock. Trocar de npm passa a ser uma decisao
# explicita: bump do engines + lock regerado no mesmo commit.
engine-strict=true
